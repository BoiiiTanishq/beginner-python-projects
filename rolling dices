import random
while True:
    choice  = input("do you want to play(y/n): ").lower()
    if  choice == "y":
        die1 = random.randint(1,6)
        die2 = random.randint(1,6)
        dice_no = int(input("how many dices(1,2): "))
        if dice_no == 1:
            print(f"{die1}")
        elif dice_no == 2:
            print(f"{die1},{die2}")
        else:
            print("invalid")
    elif choice == "n":
        print ("thank You for playing")
        break
    else :
        print("inavlid") 
